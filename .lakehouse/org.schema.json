{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/org.schema.json",
  "title": "LakeHouse org identity",
  "type": "object",
  "required": ["orgName", "brand", "packageScope", "domain"],
  "properties": {
    "orgName": {
      "type": "string",
      "minLength": 1,
      "description": "GitHub organization login (mutable on rename)."
    },
    "brand": {
      "type": "string",
      "minLength": 1,
      "description": "Stable public brand name (LakeHouse Studio styling)."
    },
    "packageScope": {
      "type": "string",
      "pattern": "^@[a-z0-9][a-z0-9-]*$",
      "description": "Brand-based package scope (not the GitHub org slug)."
    },
    "domain": {
      "type": "string",
      "description": "Custom FQDN for public links/badges, or REPLACE_WITH_CUSTOM_DOMAIN until chosen. github.io is rejected.",
      "anyOf": [
        { "const": "REPLACE_WITH_CUSTOM_DOMAIN" },
        {
          "type": "string",
          "pattern": "^(?!.*\\.github\\.io$)([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,}$"
        }
      ]
    }
  },
  "additionalProperties": true
}
