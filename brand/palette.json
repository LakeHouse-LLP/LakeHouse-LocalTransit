{
  "brand": "LakeHouse Studio",
  "version": "0.3.0",
  "mode": "dark-only",
  "canonical": "{owner}/.github/brand",
  "note": "Local copy of kit v0.3 tokens for this template. Prefer the org brand kit when published.",
  "colors": {
    "background": "#1E1E1E",
    "foreground": "#F2EFE9",
    "muted": "#C7C5C0",
    "accent": "#7DFFFF",
    "accentHover": "#B3FFFF",
    "accentPressed": "#4FE0E6",
    "danger": "#FF6B6B"
  },
  "tokens": {
    "color.accent": "#7DFFFF",
    "color.background": "#1E1E1E",
    "font.family.sans": "Geist"
  },
  "font": {
    "sans": ["Geist", "Segoe UI Variable Text", "SF Pro Text", "system-ui", "sans-serif"],
    "mono": ["Geist Mono", "ui-monospace", "Cascadia Mono", "Consolas", "monospace"],
    "cjk": ["Noto Sans SC", "Source Han Sans SC", "PingFang SC", "Microsoft YaHei", "sans-serif"]
  },
  "theme": {
    "dark": {
      "background": "#1E1E1E",
      "foreground": "#F2EFE9",
      "accent": "#7DFFFF",
      "fontFamily": "Geist"
    }
